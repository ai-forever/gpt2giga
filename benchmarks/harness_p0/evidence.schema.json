{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt2giga.dev/schemas/harness-p0-evidence-v1.json",
  "title": "Harness P0 comparison cell evidence",
  "type": "object",
  "required": [
    "schema_version",
    "comparison_id",
    "cell_id",
    "target",
    "environment",
    "input",
    "timestamps",
    "status",
    "failure",
    "semantic_cells",
    "artifacts",
    "metrics",
    "redaction",
    "reproduction"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "comparison_id": {"type": "string", "minLength": 1},
    "cell_id": {"type": "string", "minLength": 1},
    "target": {"type": "object", "required": ["id", "distribution", "version"]},
    "environment": {"type": "object"},
    "input": {"type": "object", "required": ["fixture_id", "fixture_sha256", "seed_git_sha", "workflow_id", "repetition", "model_route"]},
    "timestamps": {"type": "object", "required": ["started_at", "finished_at", "monotonic_duration_seconds"]},
    "status": {"enum": ["passed", "failed", "invalid", "skipped"]},
    "failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["class", "reason_code"],
          "properties": {
            "class": {"enum": ["product", "adapter", "model", "environment"]},
            "reason_code": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "semantic_cells": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "status", "reason_code", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^W[1-5]-S[1-5]$"},
          "status": {"enum": ["passed", "failed", "unsupported", "invalid", "excluded"]},
          "reason_code": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path", "sha256", "byte_size", "media_type", "producer", "created_at"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_size": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "producer": {"type": "string", "minLength": 1},
          "created_at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "metrics": {"type": "object"},
    "redaction": {
      "type": "object",
      "required": ["content_capture_enabled", "secret_scan_passed"],
      "properties": {
        "content_capture_enabled": {"const": false},
        "secret_scan_passed": {"const": true},
        "canary_found": {"type": ["boolean", "null"]}
      }
    },
    "reproduction": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
      }
    }
  },
  "additionalProperties": true
}
