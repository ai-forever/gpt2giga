{
  "schema_version": 1,
  "api_mode": "openai-v1",
  "cases": [
    {
      "id": "tool-call",
      "kind": "tool",
      "request": {
        "messages": [{"role": "user", "content": "Return stock for sku-1."}],
        "tools": [{"type": "function", "function": {"name": "lookup_stock"}}]
      },
      "expected": {"tool_name": "lookup_stock", "arguments": {"sku": "sku-1"}}
    },
    {
      "id": "streaming",
      "kind": "stream",
      "request": {"messages": [{"role": "user", "content": "Say ready."}], "stream": true},
      "expected": {"text": "ready", "terminal_event": "[DONE]"}
    },
    {
      "id": "usage",
      "kind": "usage",
      "request": {"messages": [{"role": "user", "content": "Count this request."}]},
      "expected": {"prompt_tokens": 4, "completion_tokens": 2, "total_tokens": 6}
    },
    {
      "id": "cancellation",
      "kind": "cancellation",
      "request": {"messages": [{"role": "user", "content": "Wait for cancellation."}], "stream": true},
      "expected": {"cancelled": true, "terminal_response_forbidden": true}
    },
    {
      "id": "protocol-error",
      "kind": "error",
      "request": {"messages": [{"role": "user", "content": "Return a fixed error."}]},
      "expected": {"status": 429, "type": "rate_limit_error", "code": "fixture_rate_limit"}
    }
  ]
}
