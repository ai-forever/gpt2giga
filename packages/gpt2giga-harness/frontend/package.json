{
  "name": "@gpt2giga/harness-cockpit-v2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "node scripts/produce-assets.mjs",
    "build:release": "node scripts/produce-assets.mjs --require-clean",
    "build:bundle": "vite build",
    "build:package": "node scripts/package-assets.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:determinism",
    "check:determinism": "node scripts/check-determinism.mjs",
    "generate:brand": "node ../branding/generate-assets.mjs --frontend-only",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "katex": "0.16.22",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
}
