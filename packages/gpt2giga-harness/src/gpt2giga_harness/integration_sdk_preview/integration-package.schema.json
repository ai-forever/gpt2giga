{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workbench:integration-package:v1",
  "title": "IntegrationPackage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "version", "publisher", "license",
    "source_type", "source", "immutable_ref", "checksum", "components",
    "requirements", "overlays", "compatibility", "scopes", "update_policy",
    "verification_steps", "rollback_steps", "trust_evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/identity"},
    "version": {"$ref": "#/$defs/identity"},
    "publisher": {"$ref": "#/$defs/identity"},
    "license": {"$ref": "#/$defs/identity"},
    "source_type": {"enum": ["curated_catalog", "provider_marketplace", "git", "local", "package", "raw_mcp"]},
    "source": {"$ref": "#/$defs/text"},
    "immutable_ref": {"$ref": "#/$defs/identity"},
    "checksum": {"$ref": "#/$defs/checksum"},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "overlays": {"type": "array", "items": {"$ref": "#/$defs/overlay"}},
    "compatibility": {"type": "array", "items": {"$ref": "#/$defs/compatibility"}},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scope"}},
    "update_policy": {"enum": ["pinned", "manual_review", "track_channel_with_review"]},
    "verification_steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
    "rollback_steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
    "trust_evidence": {"type": "array", "items": {"$ref": "#/$defs/trust"}}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~-]{0,255}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope": {"enum": ["managed_home", "project", "user_home"]},
    "componentType": {"enum": ["mcp", "skill", "plugin", "extension", "harness_adapter"]},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "portable"],
      "properties": {"id": {"$ref": "#/$defs/identity"}, "type": {"$ref": "#/$defs/componentType"}, "portable": {"type": "boolean"}}
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "classification", "reason", "argv", "locator", "checksum", "secret_owner", "environment"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "type": {"enum": ["permission", "secret", "command", "hook", "binary", "package", "file", "network"]},
        "classification": {"enum": ["review_required", "explicit_approval", "provider_handoff", "forbidden"]},
        "reason": {"$ref": "#/$defs/text"},
        "argv": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "locator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
        "checksum": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/checksum"}]},
        "secret_owner": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
        "environment": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}}
      }
    },
    "overlay": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "component_ids", "requirement_ids"],
      "properties": {
        "target_id": {"$ref": "#/$defs/identity"},
        "component_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
        "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "minimum_version", "maximum_version_exclusive", "required_capabilities"],
      "properties": {
        "target_id": {"$ref": "#/$defs/identity"},
        "minimum_version": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
        "maximum_version_exclusive": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
        "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}}
      }
    },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "authority", "revision"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["source", "publisher", "license", "signature", "scan"]},
        "status": {"enum": ["verified", "delegated", "unverified", "blocked"]},
        "authority": {"$ref": "#/$defs/identity"},
        "revision": {"$ref": "#/$defs/identity"}
      }
    }
  }
}
