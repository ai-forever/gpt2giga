{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workbench:extension-target:v1",
  "title": "ExtensionTargetDescriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "component_types", "scopes", "capabilities", "trust_evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/identity"},
    "revision": {"$ref": "#/$defs/identity"},
    "component_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["mcp", "skill", "plugin", "extension", "harness_adapter"]}},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["managed_home", "project", "user_home"]}},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
    "trust_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trust"}}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+~-]{0,255}$"},
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "authority", "revision"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["source", "publisher", "license", "signature", "scan"]},
        "status": {"enum": ["verified", "delegated", "unverified", "blocked"]},
        "authority": {"$ref": "#/$defs/identity"},
        "revision": {"$ref": "#/$defs/identity"}
      }
    }
  }
}
